  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "code",
          "detail",
          "status",
          "title"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "sku",
          "name",
          "unit_cost_cents",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "uom": {
            "type": "string"
          },
          "unit_cost_cents": {
            "type": "integer"
          },
          "reorder_point": {
            "type": "integer"
          },
          "reorder_qty": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "warehouse",
              "bin",
              "transit"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "StockLevel": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "location_id": {
            "type": "string"
          },
          "on_hand": {
            "type": "integer"
          },
          "avg_cost_cents": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "Movement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "receive",
              "issue",
              "adjust",
              "transfer_out",
              "transfer_in"
            ]
          },
          "product_id": {
