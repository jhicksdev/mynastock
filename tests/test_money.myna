@target(py)
<unittest
<mynastock.core:{concat,is_digits,parse_cents,format_cents,blend,stock_status,suggested_qty}

$MoneyTests<unittest.TestCase{
  @test_concat{
    !?concat([])==""
    !?concat(["a"])=="a"
    !?concat(["a","b"])=="ab"
    !?concat(["a","b"],",")=="a,b"
  }

  @test_is_digits{
    !?is_digits("0")
    !?is_digits("1234567890")
    !?!is_digits("")
    !?!is_digits("12a")
    !?!is_digits(" 1")
  }

  @test_parse_cents{
    !?parse_cents("12")==1200
    !?parse_cents("12.3")==1230
    !?parse_cents("12.34")==1234
    !?parse_cents("0.05")==5
    !?parse_cents("00012")==1200
    !?parse_cents("1.")===N
    !?parse_cents(".5")===N
    !?parse_cents("12.345")===N
    !?parse_cents("-1")===N
    !?parse_cents("")===N
    !?parse_cents("1,000")===N
    !?parse_cents("1.2.3")===N
  }

  @test_format_cents{
    !?format_cents(1234)=="12.34"
    !?format_cents(5)=="0.05"
    !?format_cents(0)=="0.00"
    !?format_cents(-5)=="-0.05"
    !?format_cents(100)=="1.00"
  }

  @test_blend{
    !?blend(0,0,10,250)==250
    !?blend(10,250,10,350)==300
    !?blend(10,250,0,0)==250
    !?blend(0,999,0,0)==0
  }

  @test_stock_status{
    !?stock_status(0,5)=="out"
    !?stock_status(3,5)=="low"
    !?stock_status(5,5)=="low"
    !?stock_status(6,5)=="ok"
  }

  @test_suggested_qty{
    !?suggested_qty(2,5,20)==18
    !?suggested_qty(5,5,20)==15
    !?suggested_qty(9,5,20)==0
  }
}

@main{unittest.main()}
