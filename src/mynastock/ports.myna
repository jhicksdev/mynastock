@target(py, js)
<.core:{Product,Location,StockLevel,Movement,Operation,Result,fail}

# Repository contract. Implementations override every method; the bodies here exist
# only to document the surface and to fail loudly when a method is missing.
$Repo{
  @product_by_sku(sku:s)->Product?{^N}
  @product_by_id(id:s)->Product?{^N}
  @location_by_code(code:s)->Location?{^N}
  @level(pid:s,lid:s)->StockLevel?{^N}
  @find_operation(key:s)->Operation?{^N}
  @insert_product(product:Product)->Result{^fail("repo.not_implemented","insert_product is not implemented")}
  @update_product(product:Product,expected_version:i)->Result{^fail("repo.not_implemented","update_product is not implemented")}
  @insert_location(l:Location)->Result{^fail("repo.not_implemented","insert_location is not implemented")}
  @apply(op:Operation,ms:[Movement],levels:[StockLevel])->Result{^fail("repo.not_implemented","apply is not implemented")}
  @list_products->[Product]{^[]}
  @list_locations->[Location]{^[]}
  @list_levels->[StockLevel]{^[]}
  @list_movements->[Movement]{^[]}
}
